# Copy to `.env` at the monorepo root (recommended) or under `apps/api/`.
# The API loads root `.env` first, then `apps/api/.env` (override).
# With docker compose (root user): use authSource=admin.

MONGODB_URI=mongodb://dayparty:partyday@127.0.0.1:27017/?authSource=admin
MONGODB_DB=dayparty
PORT=3001
# Optional public URLs used in auth magic-link logs.
# WEB_PUBLIC_URL is where the browser app runs (link opens /login?token=...).
# API_PUBLIC_URL is kept for debugging/direct API verification links.
# WEB_PUBLIC_URL=http://localhost:5173
# API_PUBLIC_URL=http://localhost:3001

# Optional: pnpm --filter @dayparty/api seed
# SEED_EMAIL=dev@day.party
# SEED_FORCE_TASKS=1

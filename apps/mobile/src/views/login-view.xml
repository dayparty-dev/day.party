<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo" class="page">
  <ActionBar title="{{ actionBarTitle }}" />

  <ScrollView>
    <StackLayout class="p-20">
      <Label text="{{ emailLabel }}" class="label" />
      <TextField hint="{{ emailHint }}" text="{{ email }}" keyboardType="email" autocorrect="false" autocapitalizationType="none" class="input" />

      <Button text="{{ sendMagicLabel }}" tap="{{ onSendLink }}" class="-primary m-t-12" />

      <Label text="{{ tokenLabel }}" class="label m-t-20" textWrap="true" />
      <TextField hint="{{ tokenHint }}" text="{{ tokenOrUrl }}" autocorrect="false" class="input" />

      <Button text="{{ verifyLabel }}" tap="{{ onVerify }}" class="-outline m-t-8" />

      <Label text="{{ statusMessage }}" class="footnote m-t-12" textWrap="true" visibility="{{ statusVisibility }}" />

      <StackLayout visibility="{{ errorBannerVisibility }}" class="error-banner m-t-12">
        <Label text="{{ errorMessage }}" textWrap="true" class="error-text" />
        <Button text="{{ retryLabel }}" tap="{{ onRetry }}" class="-outline m-t-8" visibility="{{ retryVisibility }}" />
      </StackLayout>
    </StackLayout>
  </ScrollView>
</Page>

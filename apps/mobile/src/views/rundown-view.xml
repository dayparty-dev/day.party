<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo" loaded="onLoaded" class="page">
  <ActionBar title="Resumen del día">
    <ActionItem text="Salir" ios.position="right" android.position="actionBar" tap="{{ onLogout }}" />
  </ActionBar>

  <GridLayout rows="auto, auto, auto, *">
    <StackLayout row="0" visibility="{{ errorBannerVisibility }}" class="error-banner">
      <Label text="{{ errorMessage }}" textWrap="true" class="error-text" />
      <Button text="Reintentar" tap="{{ onRetry }}" class="-outline m-t-8" />
    </StackLayout>

    <GridLayout row="1" rows="auto" columns="*, auto" class="p-12">
      <Label col="0" text="{{ summaryText }}" class="h3" textWrap="true" />
      <Button col="1" text="En curso" tap="{{ onOngoing }}" class="-primary" />
    </GridLayout>

    <ScrollView row="2" orientation="vertical" class="plan-scroll">
      <StackLayout class="p-12 plan-stack">
        <Label text="{{ planFootnote }}" textWrap="true" class="plan-footnote" />
        <Button text="Ajustar ventana" tap="{{ onToggleWindowEditor }}" class="-outline m-t-8" />
        <StackLayout visibility="{{ windowEditorVisibility }}" class="window-editor m-t-12">
          <Label text="Inicio (24h, HH:MM)" class="footnote" />
          <TextField text="{{ windowStartInput }}" hint="09:00" class="input m-t-4" />
          <Label text="Fin (24h, HH:MM)" class="footnote m-t-8" />
          <TextField text="{{ windowEndInput }}" hint="17:00" class="input m-t-4" />
          <GridLayout columns="auto, *" class="m-t-12">
            <Switch col="0" checked="{{ windowCrosses }}" checkedChange="{{ onWindowCrossChange }}" verticalAlignment="center" />
            <Label col="1" text="Cruza medianoche" class="footnote" textWrap="true" verticalAlignment="center" />
          </GridLayout>
          <Label text="{{ windowSaveError }}" textWrap="true" class="window-error m-t-8" />
          <Button text="{{ saveButtonText }}" tap="{{ onSaveWindow }}" isEnabled="{{ saveWindowEnabled }}" class="-primary m-t-12" />
        </StackLayout>

        <Label text="Nueva tarea" class="h3 m-t-16" />
        <TextField text="{{ newTaskTitle }}" hint="Título" class="input m-t-4" />
        <Label text="Tamaño (1–5)" class="footnote m-t-8" />
        <TextField text="{{ newTaskSize }}" hint="2" keyboardType="number" class="input m-t-4" />
        <Label text="Minutos (opcional)" class="footnote m-t-8" />
        <TextField text="{{ newTaskMinutes }}" hint="Según tamaño si vacío" keyboardType="number" class="input m-t-4" />
        <GridLayout columns="auto, *" class="m-t-8">
          <Switch col="0" checked="{{ taskEssential }}" checkedChange="{{ onEssentialChange }}" verticalAlignment="center" />
          <Label col="1" text="Esencial" class="footnote" textWrap="true" verticalAlignment="center" />
        </GridLayout>
        <GridLayout columns="auto, *" class="m-t-8">
          <Switch col="0" checked="{{ taskOptional }}" checkedChange="{{ onOptionalChange }}" verticalAlignment="center" />
          <Label col="1" text="Opcional" class="footnote" textWrap="true" verticalAlignment="center" />
        </GridLayout>
        <Label text="{{ createTaskError }}" textWrap="true" class="window-error m-t-8" />
        <Button text="{{ createTaskButtonText }}" tap="{{ onCreateTask }}" isEnabled="{{ createTaskEnabled }}" class="-primary m-t-12" />
      </StackLayout>
    </ScrollView>

    <ListView row="3" items="{{ taskRows }}" itemTap="{{ onTaskTap }}" class="list">
      <ListView.itemTemplate>
        <GridLayout columns="5, *, auto, auto" class="p-12 task-row">
          <StackLayout col="0" width="5" backgroundColor="{{ tagColor }}" verticalAlignment="stretch" />
          <StackLayout col="1">
            <Label text="{{ title }}" textWrap="true" class="task-title" />
            <Label text="{{ metaLine }}" textWrap="true" class="task-meta" />
          </StackLayout>
          <Label col="2" text="{{ runwayLabel }}" class="runway-badge" textWrap="true" />
          <Label col="3" text="{{ completeIcon }}" class="complete-icon" />
        </GridLayout>
      </ListView.itemTemplate>
    </ListView>
  </GridLayout>
</Page>
